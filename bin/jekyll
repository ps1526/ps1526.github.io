#!/usr/bin/env bash
# Wrapper: same Ruby/Bundler as ./bin/build. Use: ./bin/jekyll build | serve | ...
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
# shellcheck source=/dev/null
source "${ROOT}/bin/ruby-env.sh"
academicwebsite_prepend_ruby || exit 1
exec bundle exec jekyll "$@"
